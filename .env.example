# Environment Configuration Example
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=student_attendance
SECRET_KEY=your_secret_key_here
UPLOAD_FOLDER=uploads

# IP Camera Configuration (CCTV)
# Format: rtsp://[username]:[password]@[ip_address]:[port]/[stream_path]
# Examples for different CCTV brands:
# Ezviz: rtsp://admin@192.168.8.10:554/h264/ch1/main/av_stream
# Hikvision: rtsp://admin:password@192.168.1.64:554/Streaming/Channels/101
# Dahua: rtsp://admin:password@192.168.1.108:554/cam/realmonitor?channel=1&subtype=0
# TP-Link: rtsp://admin:password@192.168.1.100:554/stream1
RTSP_URL=rtsp://admin@192.168.8.10:554/h264/ch1/main/av_stream

# Optional ROI crop for distant-face recognition (normalized 0..1)
# Keep OFF by default. Enable only after camera framing is stable.
FACE_ROI_ENABLED=false
FACE_ROI_X=0.20
FACE_ROI_Y=0.15
FACE_ROI_W=0.60
FACE_ROI_H=0.70

# Optional multi-frame voting for more stable distant recognition
RECOGNITION_BURST_ENABLED=true
RECOGNITION_BURST_FRAMES=3
RECOGNITION_BURST_INTERVAL_MS=120
RECOGNITION_MIN_VOTES=1
RECOGNITION_FRAME_WIDTH=480

# Face matching thresholds (distance recognition tuning)
FACE_MATCH_DISTANCE_THRESHOLD=0.45
FACE_MIN_CONF_LARGE=0.60
FACE_MIN_CONF_MEDIUM=0.55
FACE_MIN_CONF_SMALL=0.48

# ArcFace embedding store (new store, separate from dlib face_encodings.pkl)
ARCFACE_EMBEDDINGS_FILE=arcface_embeddings.pkl

